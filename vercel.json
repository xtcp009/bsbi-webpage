{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm run build --prefix web && rm -rf .next && cp -R web/.next .next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/shulcloud/refresh",
      "schedule": "* * * * *"
    }
  ]
}
